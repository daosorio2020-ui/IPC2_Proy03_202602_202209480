@page
@model PeticionesModel
@{
    ViewData["Title"] = "Peticiones y Reportes";
}

<h2 class="mb-4">Consultas y Reportes</h2>

<!-- Pestañas de navegación -->
<ul class="nav nav-tabs" id="misPestañas" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.PestañaActiva == "contribuyente" ? "active" : "")" id="tab-contribuyente" data-bs-toggle="tab" data-bs-target="#contribuyente" type="button" role="tab">Consultar Contribuyente</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.PestañaActiva == "iva" ? "active" : "")" id="tab-iva" data-bs-toggle="tab" data-bs-target="#iva" type="button" role="tab">Resumen IVA</button>
    </li>
</ul>

<!-- Contenido de las pestañas -->
<div class="tab-content border border-top-0 p-4 mb-4" id="contenidoPestañas">
   
    <!-- Pestaña 1: Consultar Contribuyente -->
    <div class="tab-pane fade @(Model.PestañaActiva == "contribuyente" ? "show active" : "")" id="contribuyente" role="tabpanel">
        <form method="post" asp-page-handler="ConsultarContribuyente" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">NIT del Contribuyente</label>
                <input type="text" name="nit" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Tipo de Factura</label>
                <select name="tipo" class="form-select">
                    <option value="emitidas">Emitidas</option>
                    <option value="recibidas">Recibidas</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Consultar</button>
            </div>
        </form>
    </div>

    <!-- Pestaña 2: Resumen de IVA -->
    <div class="tab-pane fade @(Model.PestañaActiva == "iva" ? "show active" : "")" id="iva" role="tabpanel">
        <form method="post" asp-page-handler="ResumenIva" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Fecha (dd/mm/yyyy)</label>
                <input type="text" name="fecha" class="form-control" placeholder="Ej: 15/01/2025" required />
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-primary w-100">Generar Resumen</button>
            </div>
        </form>
    </div>
</div>

<!-- Área de Resultados -->
@if (Model.ResultadoJson != null)
{
    <h4>Resultado de la Consulta:</h4>
    <div class="card bg-light p-3">
        <pre><code>@Model.ResultadoJson</code></pre>
    </div>
}