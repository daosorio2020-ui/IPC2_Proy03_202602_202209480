@page
@model PeticionesModel
@{
    ViewData["Title"] = "Peticiones y Reportes";
}

<h2 class="mb-4">Consultas y Reportes</h2>

<!-- Pestañas de navegación -->
<ul class="nav nav-tabs" id="misPestañas" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.PestañaActiva == "contribuyente" ? "active" : "")" id="tab-contribuyente" data-bs-toggle="tab" data-bs-target="#contribuyente" type="button" role="tab">Consultar Contribuyente</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.PestañaActiva == "iva" ? "active" : "")" id="tab-iva" data-bs-toggle="tab" data-bs-target="#iva" type="button" role="tab">Resumen IVA</button>
    </li>
</ul>

<!-- Contenido de las pestañas -->
<div class="tab-content border border-top-0 p-4 mb-4" id="contenidoPestañas">
   
    <!-- Pestaña 1: Consultar Contribuyente -->
    <div class="tab-pane fade @(Model.PestañaActiva == "contribuyente" ? "show active" : "")" id="contribuyente" role="tabpanel">
        <form method="post" asp-page-handler="ConsultarContribuyente" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">NIT del Contribuyente</label>
                <input type="text" name="nit" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Tipo de Factura</label>
                <select name="tipo" class="form-select">
                    <option value="emitidas">Emitidas</option>
                    <option value="recibidas">Recibidas</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Consultar</button>
            </div>
        </form>
    </div>

    <!-- Pestaña 2: Resumen de IVA -->
    <div class="tab-pane fade @(Model.PestañaActiva == "iva" ? "show active" : "")" id="iva" role="tabpanel">
        <form method="post" asp-page-handler="ResumenIva" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Fecha (dd/mm/yyyy)</label>
                <input type="text" name="fecha" class="form-control" placeholder="Ej: 15/01/2025" required />
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-primary w-100">Generar Resumen</button>
            </div>
        </form>
    </div>
</div>

<!-- Área de Resultados y Gráfica -->
@if (Model.ResultadoJson != null && Model.ResultadoJson != "Error o no se encontraron datos.")
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Resultado de la Consulta:</h4>
        <!-- Botón para descargar el PDF -->
        <button class="btn btn-danger" onclick="descargarPDF()">
            <i class="bi bi-file-pdf"></i> Exportar a PDF
        </button>
    </div>

    <!-- Contenedor que será transformado a PDF -->
    <div id="areaImprimir" class="p-3 bg-white">
        <div class="row">
            <!-- Columna de Datos JSON -->
            <div class="col-md-4">
                <div class="card bg-light p-3">
                    <pre><code>@Model.ResultadoJson</code></pre>
                </div>
            </div>
           
            <!-- Columna de Gráfica -->
            <div class="col-md-8">
                <div class="card p-3">
                    <canvas id="graficaResultados"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Librerías JS para Gráficas y PDF -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        // Función para exportar a PDF ajustada
        function descargarPDF() {
            const elemento = document.getElementById('areaImprimir');
            const opciones = {
                margin:       0.3, // Márgenes más pequeños
                filename:     'Reporte_Peticiones_SAT.pdf',
                image:        { type: 'jpeg', quality: 1 },
                // scale: 2 mejora la resolución, scrollY: 0 evita recortes si la página estaba scrolleada
                html2canvas:  { scale: 2, useCORS: true, scrollY: 0 },
                jsPDF:        { unit: 'in', format: 'legal', orientation: 'landscape' } // Formato legal da más espacio a lo ancho
            };
           
            html2pdf().set(opciones).from(elemento).save();
        }

        document.addEventListener("DOMContentLoaded", function() {
            const rawData = @Html.Raw(Model.ResultadoJson);
            const tabActiva = '@Model.PestañaActiva';
           
            if (tabActiva === 'iva' && Array.isArray(rawData)) {
                const ctx = document.getElementById('graficaResultados').getContext('2d');
               
                const labelsNit = rawData.map(d => d.nit);
                const ivaEmitido = rawData.map(d => d.ivaEmitido);
                const ivaRecibido = rawData.map(d => d.ivaRecibido);

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labelsNit,
                        datasets: [
                            {
                                label: 'IVA Emitido',
                                data: ivaEmitido,
                                backgroundColor: 'rgba(54, 162, 235, 0.7)',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                borderWidth: 1
                            },
                            {
                                label: 'IVA Recibido',
                                data: ivaRecibido,
                                backgroundColor: 'rgba(255, 99, 132, 0.7)',
                                borderColor: 'rgba(255, 99, 132, 1)',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        animation: false, // <-- DESACTIVA LA ANIMACIÓN PARA QUE EL PDF NO SALGA CORTADO
                        plugins: {
                            title: {
                                display: true,
                                text: 'Resumen de Movimientos de IVA por NIT'
                            }
                        }
                    }
                });
            }
        });
    </script>

}
else if (Model.ResultadoJson != null)
{
    <div class="alert alert-warning mt-3">@Model.ResultadoJson</div>
}